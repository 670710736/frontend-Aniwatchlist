ADDR=:8080
FRONTEND_ORIGINS=http://localhost:3000
ANILIST_GRAPHQL_URL=https://graphql.anilist.co

# Required: generate with `openssl rand -hex 32`. Do not commit the generated value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_TTL=24h

# PostgreSQL: start it with `docker compose up -d` from backend/.
POSTGRES_DB=aniwatchlist
POSTGRES_USER=aniwatchlist
# Set a unique password before starting PostgreSQL. Keep backend/.env out of git.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://aniwatchlist:${POSTGRES_PASSWORD}@localhost:5432/aniwatchlist?sslmode=disable
