PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
ANILIST_GRAPHQL_URL=https://graphql.anilist.co

# Generate a unique value with `openssl rand -hex 32`; do not commit it.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL=24h

# Local Docker settings.
POSTGRES_DB=aniwatchlist
POSTGRES_USER=aniwatchlist
POSTGRES_PASSWORD=replace-with-a-random-password

# Supabase Session pooler URL from Project Settings > Database.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres?sslmode=require
